# ==============================================================================
# 📊 GOOGLE SHEETS API
# Necessário para integração do banco de dados (captura de leads e dados de acesso)
# ==============================================================================

# E-mail da Service Account (ex: meu-roboc@meu-projeto.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chave Privada da Service Account. 
# IMPORTANTE: Deve conter o bloco inteiro "-----BEGIN PRIVATE KEY-----\n..." garantindo que as quebras de linha fiquem no formato "\n" literal.
GOOGLE_PRIVATE_KEY=

# ID da Planilha do Google Sheets (É aquele código estranho e gigante que fica na URL da planilha)
GOOGLE_SHEET_ID=

# Nome da aba da planilha focada em conversões de clientes (Padrão: "Leads")
GOOGLE_SHEET_TAB=


# ==============================================================================
# 🔐 AUTENTICAÇÃO DO PAINEL ADMIN
# Senha de proteção para a página "/admin" onde se postam os comunicados do Hero
# ==============================================================================
ADMIN_PASSWORD=


# ==============================================================================
# ☁️ VERCEL BLOB STORAGE
# Salva permanentemente as imagens upadas pelas postagens criadas via painel admin
# ==============================================================================
# Token secreto gerado na aba "Storage" da Vercel (ex: vercel_blob_rw_1234567...)
BLOB_READ_WRITE_TOKEN=


# ==============================================================================
# 📱 INTEGRAÇÃO COM TELEGRAM
# Envio instantâneo dos formulários de leads para notificar a equipe no chat
# ==============================================================================
# Token do bot fornecido pelo BotFather no Telegram (ex: 12345:ABCdE-fGhI...)
TELEGRAM_BOT_TOKEN=

# ID da conversa ou do grupo para onde a mensagem vai ser enviada (Cuidado: IDs de grupos do Telegram geralmente começam com o sinal negativo "-")
TELEGRAM_CHAT_ID=